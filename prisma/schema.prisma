// Invariantes que o Prisma não expressa (CHECK, triggers, roles) ficam em SQL nas migrations.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ElectionStatus {
  DRAFT
  OPEN
  CLOSED
  TALLIED

  @@map("election_status")
}

/// Transições e congelamento de campos são garantidos por trigger (ver migration).
model Election {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  status         ElectionStatus      @default(DRAFT)
  startsAt       DateTime            @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime            @map("ends_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  candidates     Candidate[]
  voters         Voter[]
  votingSessions VotingSession[]
  ballots        Ballot[]
  idempotency    IdempotencyRecord[]
  auditEvents    AuditEvent[]

  @@map("elections")
}

/// Só pode ser criado/alterado/removido enquanto a eleição está em DRAFT (trigger).
model Candidate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  electionId String   @map("election_id") @db.Uuid
  number     Int
  name       String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ballots    Ballot[]

  @@unique([electionId, number])
  /// Alvo da FK composta de ballots: garante que o candidato votado pertence à mesma eleição.
  @@unique([electionId, id])
  @@map("candidates")
}

/// Cadastro de eleitores. A identificação original NÃO é armazenada: só o HMAC com pepper.
/// Deliberadamente sem timestamp de habilitação/voto (ver docs/threat-model.md, T07/T16).
model Voter {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  electionId     String   @map("election_id") @db.Uuid
  identifierHmac Bytes    @map("identifier_hmac")
  hasVoted       Boolean  @default(false) @map("has_voted")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  election       Election @relation(fields: [electionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([electionId, identifierHmac])
  @@map("voters")
}

/// Autorização de voto de uso único. Deliberadamente SEM voter_id e SEM created_at:
/// nada aqui aponta para quem foi habilitado (ver docs/threat-model.md, T07).
/// O token em claro nunca é armazenado; só o SHA-256 dele.
model VotingSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  electionId String   @map("election_id") @db.Uuid
  tokenHash  Bytes    @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  consumed   Boolean  @default(false)
  election   Election @relation(fields: [electionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([electionId])
  @@map("voting_sessions")
}

enum BallotKind {
  CANDIDATE
  BLANK
  NULL_VOTE

  @@map("ballot_kind")
}

/// A urna. Append-only (trigger). Deliberadamente SEM voter_id, SEM session_id e SEM created_at.
/// O id é UUID v4 gerado na aplicação (entra no commitment); nunca v7, que embute horário.
model Ballot {
  id          String     @id @db.Uuid
  electionId  String     @map("election_id") @db.Uuid
  kind        BallotKind
  candidateId String?    @map("candidate_id") @db.Uuid
  /// SHA-256 do token com separação de domínio: um token, no máximo um voto.
  nullifier   Bytes      @unique
  /// SHA-256 do conteúdo canônico do voto; folha da Merkle root na apuração.
  commitment  Bytes      @unique
  election    Election   @relation(fields: [electionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// FK composta: o candidato votado pertence à MESMA eleição do voto.
  candidate   Candidate? @relation(fields: [electionId, candidateId], references: [electionId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([electionId])
  @@map("ballots")
}

/// Respostas já dadas a POST /ballots, para retries. Apagadas no fechamento da eleição.
/// scope_key e request_fingerprint são HMACs com o token como chave: sem o token, não revelam nada.
model IdempotencyRecord {
  scopeKey           Bytes    @id @map("scope_key")
  electionId         String   @map("election_id") @db.Uuid
  requestFingerprint Bytes    @map("request_fingerprint")
  responseStatus     Int      @map("response_status")
  responseBody       Json     @map("response_body")
  election           Election @relation(fields: [electionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([electionId])
  @@map("idempotency_records")
}

enum AuditEventType {
  ELECTION_CREATED
  CANDIDATE_CREATED
  VOTER_REGISTERED
  ELECTION_OPENED
  VOTER_AUTHORIZED
  ELECTION_CLOSED
  BALLOT_BOX_SEALED
  TALLY_STARTED
  TALLY_COMPLETED

  @@map("audit_event_type")
}

enum AuditActorType {
  ADMIN
  POLL_WORKER
  SYSTEM

  @@map("audit_actor_type")
}

/// Log append-only em hash chain. Cada evento guarda o hash do anterior; o banco exige o
/// encadeamento no INSERT e proíbe UPDATE/DELETE. Nunca contém CPF, token ou escolha de voto.
/// Não existe evento por voto (VOTE_ACCEPTED): correlação por horário (T16).
model AuditEvent {
  seq             Int            @id
  eventType       AuditEventType @map("event_type")
  actorType       AuditActorType @map("actor_type")
  actorIdentifier String         @map("actor_identifier")
  electionId      String?        @map("election_id") @db.Uuid
  payload         Json
  previousHash    Bytes          @map("previous_hash")
  eventHash       Bytes          @unique @map("event_hash")
  createdAt       DateTime       @map("created_at") @db.Timestamptz(3)
  election        Election?      @relation(fields: [electionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([electionId, seq])
  @@map("audit_events")
}
