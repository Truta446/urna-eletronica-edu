# Somente para desenvolvimento local. Nunca reutilize estes valores fora daqui.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# A aplicação conecta com a role de MENOR PRIVILÉGIO (urna_app); só as migrations usam o dono.
# A role é global no cluster: use a MESMA senha nas URLs de dev e de teste.
DATABASE_URL=postgresql://urna_app:urna_app_dev_password@localhost:5440/urna?schema=public
MIGRATION_DATABASE_URL=postgresql://urna:urna_dev_password@localhost:5440/urna?schema=public
TEST_DATABASE_URL=postgresql://urna_app:urna_app_dev_password@localhost:5440/urna_test?schema=public
TEST_MIGRATION_DATABASE_URL=postgresql://urna:urna_dev_password@localhost:5440/urna_test?schema=public

# Credenciais de administrador: label:sha256(token). Gere novas com: npm run operator:token -- <label>
# O token do exemplo abaixo (APENAS DESENVOLVIMENTO) é: j6WNRqkR3Fj0EXV014qjYqUWLQVA8vVT_JUhIhYlg5M
ADMIN_CREDENTIALS=dev-admin:d3f435154a11f1b014c73eaa4331fbae0844b3cdf465685e92bf58033b647fce

# Pepper do HMAC dos identificadores de eleitor (>= 32 bytes, base64url). NUNCA no mesmo lugar que o banco.
# Gere com: npm run secret:generate   (valor abaixo: APENAS DESENVOLVIMENTO)
VOTER_ID_PEPPER=p_AIX_e2VfNOfczv4SZP9evdjc8mqHdgBguoeI1ZXrQ

# Credenciais de mesário (habilitam eleitores; NÃO acessam /admin). Mesmo formato do admin.
# O token do exemplo abaixo (APENAS DESENVOLVIMENTO) é: 8KlRib7Uywijq5Z13HifkhFoiE9O2JPPs7v-YPd7NTQ
POLL_WORKER_CREDENTIALS=dev-poll-worker:74f73cde27cc1af88840f4b094cf28565375465b1797c7ac6082cd2057846430

# Validade do token de votação, em segundos (30 a 3600).
VOTING_SESSION_TTL_SECONDS=300

# Chave Ed25519 que assina o lacre da urna e o resultado (PKCS#8 DER, base64url).
# Gere com: npm run signing-key:generate   (valor abaixo: APENAS DESENVOLVIMENTO)
SIGNING_PRIVATE_KEY=MC4CAQAwBQYDK2VwBCIEIHWMhXPQfCFzaMAzcm5xZWY1jDPfAuOHV2rGZ0Nzn3j-

# Requisições por minuto por IP (0 desliga; proibido em produção).
RATE_LIMIT_PER_MINUTE=300

# Benchmark (npm run bench): banco próprio, truncado a cada execução.
BENCH_DATABASE_URL=postgresql://urna_app:urna_app_dev_password@localhost:5440/urna_bench?schema=public
BENCH_MIGRATION_DATABASE_URL=postgresql://urna:urna_dev_password@localhost:5440/urna_bench?schema=public
