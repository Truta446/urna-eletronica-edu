{
  "name": "urna-eletronica-edu",
  "version": "0.1.0",
  "private": true,
  "description": "Prot\u00f3tipo educacional de backend de urna eletr\u00f4nica. N\u00e3o use em elei\u00e7\u00f5es reais.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy && tsx scripts/setup-app-role.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "secret:generate": "node -e \"process.stdout.write(require('node:crypto').randomBytes(32).toString('base64url') + '\\n')\"",
    "operator:token": "tsx scripts/operator-token.ts",
    "signing-key:generate": "tsx scripts/signing-key.ts",
    "verify:result": "tsx scripts/verify-result.ts",
    "trustees:keygen": "tsx scripts/trustees-keygen.ts",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts",
    "bench": "tsx --env-file-if-exists=.env scripts/bench.ts",
    "web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:lint": "npm --prefix web run lint",
    "web:e2e": "npm --prefix web run e2e"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@hpke/core": "^1.9.0",
    "@hpke/dhkem-x25519": "^1.8.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "canonicalize": "^5.1.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "shamir-secret-sharing": "^0.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5"
  }
}
